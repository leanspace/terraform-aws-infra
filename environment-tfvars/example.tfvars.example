# Template for environment-tfvars/<environment_name>.tfvars. Copy this file,
# rename it to the real environment name, and fill in real values.
#
# Real per-environment tfvars are intentionally untracked (see .gitignore) -
# this repo is public and those files carry real VPC/subnet IDs, S3 bucket
# names, and similar operational details that shouldn't be exposed here.

########################################
# acm
########################################

domain_name       = "example.leanspace.io"
alternative_names = ["*.example.leanspace.io"]

########################################
# opensearch
########################################

deployment_mode = "DEV" # PROD | DEV | CUSTOM

########################################
# eks
########################################

# Leave vpc_id/private_subnets/public_subnets unset to have this root create
# its own VPC (see networking.tf). Set them, as below, to deploy into an
# existing VPC instead (e.g. one created outside Terraform).
vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

private_subnets = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-xxxxxxxxxxxxxxxxx",
]

public_subnets = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-xxxxxxxxxxxxxxxxx",
]

# Buckets the services/lambda IRSA role gets read/write access to. Leave empty
# to skip creating that role entirely.
services_s3_bucket_names = []

cluster_version                      = "1.36"
team_name                            = "silver"
vpc_cni_addon_version                = "v1.22.4-eksbuild.8"
kube_proxy_addon_version             = "v1.36.0-eksbuild.55"
eks_pod_identity_agent_addon_version = "v1.4.1-eksbuild.3"
coredns_addon_version                = "v1.14.3-eksbuild.16"
ebs_addon_version                    = "v1.65.0-eksbuild.2"

# "system" is the only required node group (untainted pool for CoreDNS, CSI,
# ALB controller, and cluster-autoscaler - outputs asg_name/min_nodes/
# max_nodes read this key, don't rename or omit it). Add more groups
# following the same shape as needed.
node_groups = {
  system = {
    minimum_node_count  = 1
    maximum_node_count  = 2
    desired_node_count  = 2
    node_instance_types = ["m6a.xlarge"]
    node_capacity_type  = "ON_DEMAND"
  }
}

node_security_group_tags = {}
