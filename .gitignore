# Local Terraform working state - never commit real state, only the lock file.
.terraform/
*.tfstate
*.tfstate.*
!*.tfstate.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Generated per-run, never hand-authored or committed.
terraform.tfvars
backend.hcl

# Real VPC/subnet IDs, S3 bucket names, account IDs, etc. Kept locally for
# testing/validation only - not pushed (this repo is public). The *.example
# file is a template and stays tracked.
environment-tfvars/*.tfvars
